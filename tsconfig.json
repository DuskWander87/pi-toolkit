{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["extensions/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
	"exclude": ["node_modules", "assets", "dist"]
}
